diff --git a/internal/workers/container_user.go b/internal/workers/container_user.go
new file mode 100644
index 0000000..efdca0a
--- /dev/null
+++ b/internal/workers/container_user.go
@@ -0,0 +1,31 @@
+package workers
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/moby/moby/client"
+)
+
+// ContainerUser matches the daemon's UID mapping when mounting host credentials.
+// UID 0 in a rootless daemon maps to the daemon owner, not host root.
+func (d *DockerClient) ContainerUser(ctx context.Context) (string, error) {
+	hostUser, err := CurrentUser()
+	if err != nil {
+		return "", err
+	}
+	info, err := d.cli.Info(ctx, client.InfoOptions{})
+	if err != nil {
+		return "", fmt.Errorf("inspect docker security options: %w", err)
+	}
+	return containerUserForSecurityOptions(hostUser, info.Info.SecurityOptions), nil
+}
+
+func containerUserForSecurityOptions(hostUser string, options []string) string {
+	for _, option := range options {
+		if option == "name=rootless" {
+			return "0:0"
+		}
+	}
+	return hostUser
+}
diff --git a/internal/workers/container_user_test.go b/internal/workers/container_user_test.go
new file mode 100644
index 0000000..c90a214
--- /dev/null
+++ b/internal/workers/container_user_test.go
@@ -0,0 +1,22 @@
+package workers
+
+import "testing"
+
+func TestContainerUserForSecurityOptions(t *testing.T) {
+	tests := []struct {
+		name    string
+		options []string
+		want    string
+	}{
+		{"rootful", []string{"name=seccomp,profile=builtin", "name=cgroupns"}, "1001:1001"},
+		{"rootless", []string{"name=seccomp,profile=builtin", "name=rootless", "name=cgroupns"}, "0:0"},
+		{"similar-name", []string{"name=rootless-other"}, "1001:1001"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := containerUserForSecurityOptions("1001:1001", tt.options); got != tt.want {
+				t.Errorf("container user = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
