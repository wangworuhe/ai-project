# Copy to /etc/ai-project/ai-project.env on jp2, set real values, then chmod 600.
SECRET_KEY=replace-with-a-long-random-value
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
LOG_LEVEL=INFO

# Mecha remains host-local and must require an API key.
MECHA_BASE_URL=http://127.0.0.1:21212
MECHA_API_KEY=replace-with-the-mecha-api-key
GRAMMAR_AI_REVIEW_WORKER=grammar-mistake-explainer
GRAMMAR_AI_REVIEW_BATCH_SIZE=20

