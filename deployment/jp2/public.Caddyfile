{
	auto_https disable_redirects
	admin off
	servers {
		protocols h1 h2
	}
}

ai.yalacore.com {
	bind 0.0.0.0
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	request_body {
		max_size 16MB
	}
	@crossOrigin {
		header Origin *
		not header Origin https://ai.yalacore.com
	}
	respond @crossOrigin 403
	@crossSite header Sec-Fetch-Site cross-site
	respond @crossSite 403
	basic_auth {
		{$PUBLIC_USERNAME} {$PUBLIC_PASSWORD_HASH}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	reverse_proxy 127.0.0.1:8080 {
		# Browsers authenticate only at this edge; never forward the password.
		header_up -Authorization
	}
}
