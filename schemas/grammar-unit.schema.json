{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.yala/grammar-unit.schema.json",
  "title": "Grammar Unit Import Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book", "unit", "media", "body", "exercises"],
  "properties": {
    "schema_version": { "const": 1 },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "edition", "author"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "author": { "type": ["string", "null"] }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "grammar_point", "body_page", "exercise_page", "sort_order", "status"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "grammar_point": { "type": ["string", "null"] },
        "body_page": { "type": "integer", "minimum": 1 },
        "exercise_page": { "type": "integer", "minimum": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["importing", "reviewed", "published"] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/media" }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "heading_range", "sections"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "heading_range": { "$ref": "#/$defs/range" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bodySection" }
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "crop", "alt"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "crop": { "$ref": "#/$defs/crop" },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "bodySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "range", "heading_range", "heading", "media"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "heading_range": { "$ref": "#/$defs/range" },
        "heading": { "type": "string", "minLength": 1 },
        "media": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "order", "type", "normalization", "points"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "normalization": { "type": "string", "minLength": 1 },
        "points": { "type": "number", "minimum": 0 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "primary", "source_text"],
      "properties": {
        "values": { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 },
        "primary": { "type": "boolean" },
        "source_text": { "type": "string" }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "display_answer", "grading_mode", "source_page", "source_label", "verification_status", "variants"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "display_answer": { "type": "string" },
        "grading_mode": { "type": "string", "minLength": 1 },
        "note": { "type": ["string", "null"] },
        "source_page": { "type": "integer", "minimum": 1 },
        "source_label": { "type": "string", "minLength": 1 },
        "verification_status": { "enum": ["pending", "verified"] },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "type", "example", "source_page", "content", "slots"],
      "properties": {
        "number": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "example": { "type": "boolean" },
        "source_page": { "type": "integer", "minimum": 1 },
        "content": { "type": "object" },
        "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } },
        "solution": { "$ref": "#/$defs/solution" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "instruction", "type", "source_page", "word_bank", "options", "media", "questions"],
      "properties": {
        "number": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "source_page": { "type": "integer", "minimum": 1 },
        "word_bank": { "type": "array", "items": { "type": "string" } },
        "options": { "type": "array", "items": { "type": "object" } },
        "media": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    }
  }
}
